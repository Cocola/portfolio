{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/projects", "destination": "/#work", "permanent": true },
    { "source": "/projects/", "destination": "/#work", "permanent": true },
    { "source": "/fr-fr/projects", "destination": "/#work", "permanent": true },
    { "source": "/fr-fr/projects/", "destination": "/#work", "permanent": true },
    { "source": "/a-propos", "destination": "/#about", "permanent": true },
    { "source": "/a-propos/", "destination": "/#about", "permanent": true },
    { "source": "/fr-fr/a-propos", "destination": "/#about", "permanent": true },
    { "source": "/fr-fr/a-propos/", "destination": "/#about", "permanent": true },
    { "source": "/en/projects", "destination": "/en/#work", "permanent": true },
    { "source": "/en/projects/", "destination": "/en/#work", "permanent": true },
    { "source": "/en-us/projects", "destination": "/en/#work", "permanent": true },
    { "source": "/en-us/projects/", "destination": "/en/#work", "permanent": true },
    { "source": "/en/about", "destination": "/en/#about", "permanent": true },
    { "source": "/en/about/", "destination": "/en/#about", "permanent": true },
    { "source": "/en-us/about", "destination": "/en/#about", "permanent": true },
    { "source": "/en-us/about/", "destination": "/en/#about", "permanent": true },
    { "source": "/fr-fr", "destination": "/", "permanent": true },
    { "source": "/fr-fr/", "destination": "/", "permanent": true },
    { "source": "/fr-fr/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/en-us", "destination": "/en", "permanent": true },
    { "source": "/en-us/", "destination": "/en", "permanent": true },
    { "source": "/en-us/:path*", "destination": "/en/:path*", "permanent": true }
  ]
}
