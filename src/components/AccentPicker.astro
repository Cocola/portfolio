---
import { type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const fr = locale === 'fr';

// Curated accents. `key` drives the [data-accent] token override in tokens.css —
// every accent has an explicit block there, including the default, so nothing
// here needs to special-case it. `swatch` is the dot colour shown in the picker
// (a mid, saturated take that reads in both themes).
// DEFAULT_ACCENT is the single source of truth for "nothing picked yet"; it must
// match a `key` below and have a [data-accent] block in tokens.css.
const DEFAULT_ACCENT = 'ambre';
const accents = [
  { key: 'ambre', label: fr ? 'Or' : 'Gold', swatch: 'oklch(0.7 0.13 80)' },
  { key: 'bordeaux', label: fr ? 'Bordeaux' : 'Bordeaux', swatch: 'oklch(0.5 0.15 25)' },
  { key: 'foret', label: fr ? 'Forêt' : 'Forest', swatch: 'oklch(0.45 0.1 153)' },
];
const label = fr ? 'Couleur d’accent' : 'Accent colour';
---

<div
  class="accent"
  data-accent-picker
  data-open="false"
  data-default-accent={DEFAULT_ACCENT}
>
  <button
    class="accent__toggle"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={label}
    title={label}
  >
    <span class="accent__dot accent__dot--current" aria-hidden="true"></span>
  </button>

  <div class="accent__menu" role="menu" aria-label={label}>
    {
      accents.map((a) => (
        <button
          class="accent__opt"
          type="button"
          role="menuitemradio"
          aria-checked={a.key === DEFAULT_ACCENT ? 'true' : 'false'}
          data-accent-value={a.key}
          title={a.label}
          aria-label={a.label}
          style={`--sw:${a.swatch}`}
        >
          <span class="accent__dot" aria-hidden="true" />
        </button>
      ))
    }
  </div>
</div>

<style>
  /* Collapsed footprint = one dot; the pill expands horizontally over it. */
  .accent {
    position: relative;
    display: inline-flex;
    inline-size: 22px;
    block-size: 22px;
  }
  .accent__toggle,
  .accent__opt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }

  /* Collapsed trigger: the current accent as a single clean dot (no border). */
  .accent__toggle {
    position: absolute;
    inset: 0;
    transition:
      opacity var(--dur-fast) var(--ease-out-quart),
      transform var(--dur-fast) var(--ease-out-quart);
  }
  /* Gated on a fine pointer: on touch the sticky :hover would leave the dot
     enlarged after the tap. */
  @media (hover: hover) and (pointer: fine) {
    .accent__toggle:hover {
      transform: scale(1.1);
    }
  }
  .accent[data-open='true'] .accent__toggle {
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
  }

  .accent__dot {
    inline-size: 16px;
    block-size: 16px;
    border-radius: var(--radius-pill);
    background: var(--sw, var(--accent));
  }
  .accent__dot--current {
    background: var(--accent);
  }

  /* Pill: expands in place over the toggle, growing rightward. */
  .accent__menu {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: -5px;
    z-index: 3;
    display: flex;
    gap: 7px;
    padding: 5px;
    background: var(--surface);
    border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px -14px color-mix(in oklch, var(--ink) 50%, transparent);
    /* closed */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-50%) scale(0.82);
    transform-origin: left center;
    transition:
      opacity var(--dur-fast) var(--ease-out-quart),
      transform var(--dur-fast) var(--ease-out-expo),
      visibility 0s linear var(--dur-fast);
  }
  .accent[data-open='true'] .accent__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%) scale(1);
    transition:
      opacity var(--dur-fast) var(--ease-out-quart),
      transform var(--dur-fast) var(--ease-out-expo),
      visibility 0s;
  }

  .accent__opt {
    inline-size: 20px;
    block-size: 20px;
    border-radius: var(--radius-pill);
    /* Staggered entrance. The floor is 0.9, not near-zero: a 20px dot born at
       6px reads as appearing from nothing. */
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity var(--dur-fast) var(--ease-out-quart),
      transform var(--dur-fast) var(--ease-out-expo);
  }
  .accent__opt .accent__dot {
    transition: transform var(--dur-fast) var(--ease-out-quart);
  }
  .accent[data-open='true'] .accent__opt {
    opacity: 1;
    transform: none;
  }
  /* Reveal left -> right so the pill reads as growing out of the toggle.
     30ms steps: the last dot lands under 300ms, inside the dropdown budget. */
  .accent[data-open='true'] .accent__opt:nth-child(1) {
    transition-delay: 0.02s;
  }
  .accent[data-open='true'] .accent__opt:nth-child(2) {
    transition-delay: 0.05s;
  }
  .accent[data-open='true'] .accent__opt:nth-child(3) {
    transition-delay: 0.08s;
  }

  /* Gated on a fine pointer: on touch the sticky :hover would leave the picked
     dot enlarged after the tap. */
  @media (hover: hover) and (pointer: fine) {
    .accent__opt:hover .accent__dot {
      transform: scale(1.14);
    }
  }
  /* Selected: bigger + a halo in the dot's OWN colour (no grey border). */
  .accent__opt[aria-checked='true'] .accent__dot {
    transform: scale(1.16);
    box-shadow:
      0 0 0 2px var(--surface),
      0 0 0 3.5px var(--sw);
  }

  /* Reduced motion = gentler, not zero. The fade is what tells you the menu
     opened, so it stays; only the scaling movement goes. The `visibility` leg
     has to stay too, or the close would snap before the fade-out is seen.
     Delays go: a stagger with no movement left to stagger is just latency. */
  @media (prefers-reduced-motion: reduce) {
    .accent__toggle {
      transition: opacity var(--dur-fast) var(--ease-out-quart);
    }
    .accent__menu {
      transform: translateY(-50%);
      transition:
        opacity var(--dur-fast) var(--ease-out-quart),
        visibility 0s linear var(--dur-fast);
    }
    .accent[data-open='true'] .accent__menu {
      transform: translateY(-50%);
      transition:
        opacity var(--dur-fast) var(--ease-out-quart),
        visibility 0s;
    }
    .accent__opt {
      transform: none;
      transition: opacity var(--dur-fast) var(--ease-out-quart);
    }
    .accent[data-open='true'] .accent__toggle {
      transform: none;
    }
    .accent[data-open='true'] .accent__opt {
      transition-delay: 0s;
    }
    .accent__opt .accent__dot {
      transition: none;
    }
  }
</style>

<script>
  const KEY = 'nf-accent';
  const root = document.documentElement;
  const picker = document.querySelector<HTMLElement>('[data-accent-picker]');
  if (picker) {
    const toggle = picker.querySelector<HTMLButtonElement>('.accent__toggle')!;
    const opts = Array.from(
      picker.querySelectorAll<HTMLButtonElement>('[data-accent-value]'),
    );

    const isOpen = () => picker.dataset.open === 'true';
    const setOpen = (open: boolean) => {
      picker.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    const markChecked = (value: string) => {
      for (const o of opts) {
        o.setAttribute('aria-checked', String(o.dataset.accentValue === value));
      }
    };

    const apply = (value: string, persist: boolean) => {
      // Every accent has its own [data-accent] block in tokens.css, the default
      // included, so the attribute is always set — no default to special-case.
      root.dataset.accent = value;
      markChecked(value);
      if (persist) {
        try {
          localStorage.setItem(KEY, value);
        } catch {}
      }
    };

    // Reflect the persisted choice (applied pre-paint by BaseLayout). Fall back
    // to the default if the stored value is no longer an offered accent, and
    // re-apply so a stale [data-accent] gets corrected on <html>.
    const fallback = picker.dataset.defaultAccent!;
    const keys = opts.map((o) => o.dataset.accentValue);
    let current = fallback;
    try {
      current = localStorage.getItem(KEY) || fallback;
    } catch {}
    if (!keys.includes(current)) current = fallback;
    apply(current, false);

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    for (const o of opts) {
      o.addEventListener('click', () => {
        apply(o.dataset.accentValue!, true);
        setOpen(false);
      });
    }

    // Dismiss on outside click / Escape.
    document.addEventListener('click', (e) => {
      if (!picker.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
